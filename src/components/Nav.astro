---
const links = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Services' },
  { href: '/work', label: 'Work' },
  { href: '/studios', label: 'Studios' },
  { href: '/shear-enterprises', label: 'Shear Enterprises' },
  { href: '/about', label: 'About' },
];
const path = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-paper/90 backdrop-blur border-b border-ink/10">
  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 font-display font-semibold tracking-tight text-lg">
      <img src="/images/brand/pg2-icon.png" alt="Pete Guzzo" class="h-7 w-auto" />
      Pete Guzzo
    </a>
    <nav class="hidden md:flex items-center gap-8 text-sm">
      {links.map((l) => (
        <a
          href={l.href}
          class={`hover:text-ink transition-colors ${
            path === l.href ? 'text-ink font-medium' : 'text-ink/55'
          }`}
        >
          {l.label}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-3">
      <a
        href="/contact"
        class="hidden sm:inline-flex text-sm font-medium px-4 py-2 rounded-full bg-ink text-paper hover:bg-rust transition-colors"
      >
        Let's Talk
      </a>
      <button
        id="mobile-menu-button"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        class="md:hidden -mr-2 p-2 text-ink"
      >
        <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="hidden">
          <line x1="6" y1="6" x2="18" y2="18"></line>
          <line x1="18" y1="6" x2="6" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="hidden md:hidden border-t border-ink/10 bg-paper">
    <div class="max-w-6xl mx-auto px-6 py-4 flex flex-col gap-4 text-base">
      {links.map((l) => (
        <a
          href={l.href}
          class={`${path === l.href ? 'text-ink font-medium' : 'text-ink/65'}`}
        >
          {l.label}
        </a>
      ))}
      <a href="/contact" class="font-medium text-rust">Let's Talk</a>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('hidden') === false;
    menu?.classList.toggle('hidden', isOpen);
    iconOpen?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
    btn.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
