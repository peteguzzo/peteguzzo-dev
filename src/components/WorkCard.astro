---
interface Props {
  slug: string;
  title: string;
  client?: string;
  category: string;
  thumbnail: string;
}
const { slug, title, client, category, thumbnail } = Astro.props;
---

<a href={`/work/${slug}`} class="group block">
  <div class="aspect-video w-full overflow-hidden rounded-lg bg-ink/5">
    <img
      src={thumbnail}
      alt={title}
      loading="lazy"
      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
    />
  </div>
  <div class="mt-3 flex items-baseline justify-between gap-3">
    <h3 class="font-display text-ink">{title}</h3>
    <span class="text-xs uppercase tracking-wide text-ink/40">{category.replace('-', ' ')}</span>
  </div>
  {client && <p class="text-sm text-ink/55">{client}</p>}
</a>
