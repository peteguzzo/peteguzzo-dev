        </div>
        <div class="rd-body">
          <div class="rd-viewer">
            <div class="rd-screen">
              <button type="button" class="rd-play" id="rdPlay">▶</button>
              <span class="rd-screen-label">Sample preview, not real project footage</span>
            </div>
            <div class="rd-timeline"><i></i><span class="rd-marker" style="left:18%;"></span><span class="rd-marker" style="left:52%;background:#ff5b69;"></span><span class="rd-marker" style="left:71%;"></span></div>
            <span class="rd-time">00:14 / 00:42</span>
          </div>
          <div class="rd-notes">
