#svpg-close{background:none;border:none;color:rgba(255,255,255,.5);font-size:18px;cursor:pointer;line-height:1;padding:4px;}
#svpg-log{flex:1;overflow-y:auto;padding:14px 16px;font-size:14px;line-height:1.6;color:rgba(255,255,255,.85);min-height:100px;max-height:280px;}
#svpg-log p{margin:0 0 10px;}
#svpg-inputrow{display:flex;gap:8px;padding:12px 14px;border-top:1px solid rgba(217,168,15,.2);}
#svpg-input{flex:1;padding:9px 11px;border-radius:6px;border:1px solid rgba(255,255,255,.2);background:rgba(255,255,255,.06);color:#fff;font-size:13.5px;}
#svpg-send{padding:9px 16px;border-radius:6px;border:none;background:#D9A80F;color:#0D1825;font-weight:700;cursor:pointer;font-size:13px;}
#svpg-count{font-size:11px;color:rgba(255,255,255,.65);padding:0 16px 10px;}
</style>

<script>
(function () {
  var shot = document.getElementById("rdShot");
  var app = document.getElementById("rdApp");
  var close = document.getElementById("rdClose");
  var play = document.getElementById("rdPlay");
  if (shot && app && close && play) {
    shot.addEventListener("click", function () {
      app.classList.add("open");
      app.scrollIntoView({ behavior: "smooth", block: "nearest" });
    });
    close.addEventListener("click", function () {
      app.classList.remove("open");
    });
    play.addEventListener("click", function () {
      play.textContent = play.textContent.trim() === "▶" ? "❚❚" : "▶";
    });
  }
})();

(function () {
  var trigger = document.getElementById("tcTrigger");
  var lightbox = document.getElementById("tcLightbox");
  var close = document.getElementById("tcClose");
  if (!trigger || !lightbox || !close) return;
  trigger.addEventListener("click", function () {
    lightbox.classList.add("open");
  });
  close.addEventListener("click", function () {
    lightbox.classList.remove("open");
  });
  lightbox.addEventListener("click", function (e) {
    if (e.target === lightbox) lightbox.classList.remove("open");
  });
  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape") lightbox.classList.remove("open");
  });
})();

(function () {
  var WORKER_URL = "https://pg-vpg-chat.pg2.workers.dev/chat";
  var MAX_TURNS = 5;
  var launcher = document.getElementById("svpg-launcher");
  var panel = document.getElementById("svpg-panel");
  var closeBtn = document.getElementById("svpg-close");
  var log = document.getElementById("svpg-log");
  var input = document.getElementById("svpg-input");
  var send = document.getElementById("svpg-send");
  var count = document.getElementById("svpg-count");
  if (!launcher || !panel || !closeBtn || !log || !input || !send || !count) return;

  var sessionId = sessionStorage.getItem("svpg_session") ||
    (crypto.randomUUID ? crypto.randomUUID() : String(Date.now()) + Math.random());
  sessionStorage.setItem("svpg_session", sessionId);
  var used = parseInt(sessionStorage.getItem("svpg_used") || "0", 10);
  updateCount();

  launcher.addEventListener("click", function () {
    panel.classList.toggle("svpg-open");
    if (panel.classList.contains("svpg-open")) input.focus();
  });
  closeBtn.addEventListener("click", function () {
    panel.classList.remove("svpg-open");
  });

  function updateCount() {
    var left = Math.max(0, MAX_TURNS - used);
    count.textContent = left > 0
      ? "You have " + left + " question" + (left === 1 ? "" : "s") + " left with this assistant."
      : "That's the 5. Pete would genuinely love to take it from here.";
  }

  function append(role, text) {
    var p = document.createElement("p");
    var b = document.createElement("b");
    b.textContent = role === "user" ? "You" : "Shea vPG";
    p.appendChild(b);
    p.appendChild(document.createTextNode(": " + text));
    log.appendChild(p);
    log.scrollTop = log.scrollHeight;
  }

  function ask() {
    var msg = input.value.trim();
    if (!msg || used >= MAX_TURNS) return;
    append("user", msg);
    input.value = "";
    send.disabled = true;
    fetch(WORKER_URL, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ sessionId: sessionId, message: msg }),
    })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        append("assistant", data.reply || "Something went wrong.");
        used += 1;
        sessionStorage.setItem("svpg_used", String(used));
        updateCount();
        if (data.done || used >= MAX_TURNS) {
          input.disabled = true;
          send.disabled = true;
        } else {
          send.disabled = false;
        }
      })
      .catch(function () {
        append("assistant", "Still coming online, one moment. If this keeps happening, just reach Pete directly.");
        send.disabled = false;
      });
  }

  send.addEventListener("click", ask);
  input.addEventListener("keydown", function (e) {
    if (e.key === "Enter") ask();
  });
})();
</script>
</BaseLayout>
