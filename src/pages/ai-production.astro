/* Shea vPG floating widget */
#svpg-launcher{position:fixed;bottom:24px;right:24px;z-index:9999;width:60px;height:60px;border-radius:50%;background:#D9A80F;color:#0D1825;border:none;cursor:pointer;box-shadow:0 6px 20px rgba(0,0,0,.35);font-family:'Barlow Condensed',Inter,-apple-system,sans-serif;font-weight:700;font-size:13px;letter-spacing:.02em;display:flex;align-items:center;justify-content:center;text-align:center;line-height:1.1;}
