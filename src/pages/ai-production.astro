      <div class="connect-node"><div class="connect-badge final"><svg viewBox="0 0 24 24" fill="none" stroke="#0D1825" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9l8-5 8 5"/><rect x="4" y="9" width="16" height="11"/></svg></div><p class="connect-label">Chicago</p></div>
