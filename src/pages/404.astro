---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
---

<BaseLayout title="404" description="Page not found.">
  <Hero
    eyebrow="404"
    title="This one doesn't exist."
    subtitle="Whatever brought you here, it's a dead end. Let's get you somewhere useful."
  />

  <section class="max-w-6xl mx-auto px-6 pb-16 border-t border-ink/10">
    <div class="pt-12 flex flex-wrap gap-4">
      <a href="/" class="inline-block px-6 py-3 bg-rust text-paper font-medium rounded-lg hover:bg-rust/90 transition-colors">
        Home
      </a>
      <a href="/about" class="inline-block px-6 py-3 border border-ink/20 font-medium rounded-lg hover:border-ink/40 transition-colors">
        About
      </a>
      <a href="/work" class="inline-block px-6 py-3 border border-ink/20 font-medium rounded-lg hover:border-ink/40 transition-colors">
        Work
      </a>
    </div>
  </section>
</BaseLayout>
