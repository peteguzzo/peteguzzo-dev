---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CTA from '../components/CTA.astro';
import WorkCard from '../components/WorkCard.astro';
import { getCollection } from 'astro:content';
import homeData from '../content/pages/home.json';

const work = await getCollection('work');
const featured = work.filter((w) => w.data.featured).sort((a, b) => a.data.showcaseOrder - b.data.showcaseOrder);
const studios = await getCollection('studios');

const { hero, servicesLeft, servicesRight, currentProjects, aboutTeaser, finalCta } = homeData;
---

<BaseLayout title="Pete Guzzo — Executive Producer + Operations Strategist | Tampa, FL" description="Executive Producer and Operations Strategist based in Tampa, FL. 20+ years in branded content, commercial production, studio design, and business strategy.">
  <Hero eyebrow={hero.eyebrow} title={hero.title}>
    <p class="mt-6 text-lg text-ink/65 max-w-2xl">{hero.body}</p>
    <div class="mt-8 flex flex-wrap gap-4">
      {hero.ctas.map((cta) => (
        <CTA href={cta.href} variant={cta.variant === 'primary' ? undefined : cta.variant as any}>
          {cta.label}
        </CTA>
      ))}
    </div>
  </Hero>

  <!-- What's in Motion -->
  <section class="max-w-6xl mx-auto px-6 py-20 border-t border-ink/10">
    <h2 class="font-display text-2xl md:text-3xl">What's in motion</h2>
    <p class="text-sm text-ink/40 mt-1 mb-10">Active productions and projects — right now.</p>
    <ul class="divide-y divide-ink/10 border-t border-ink/10">
      {currentProjects.map((item) => (
        <li class="flex items-start gap-6 py-6">
          <div class="flex-1 min-w-0">
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="font-display text-lg">{item.title}</h3>
              {item.href && (
                <a href={item.href} class="text-sm font-medium text-rust hover:text-ink shrink-0">{item.linkLabel}</a>
              )}
            </div>
            <div class="flex flex-wrap items-center gap-2 mt-2 mb-2">
              {item.badge && <span class="motion-badge">{item.badge}</span>}
              {item.type && <span class="motion-type">{item.type}</span>}
            </div>
            <p class="text-sm text-ink/60">{item.body}</p>
          </div>
          {item.image && (
            item.href
              ? <a href={item.href} class="shrink-0 w-36 md:w-48 rounded-lg overflow-hidden bg-ink/5 block motion-thumb">
                  <img src={item.image} alt={item.title} class="h-full w-full object-cover" loading="lazy" />
                </a>
              : <div class="shrink-0 w-36 md:w-48 rounded-lg overflow-hidden bg-ink/5 motion-thumb">
                  <img src={item.image} alt={item.title} class="h-full w-full object-cover" loading="lazy" />
                </div>
          )}
        </li>
      ))}
    </ul>
    <div class="mt-8">
      <CTA href="/current-work" variant="secondary">See everything I'm working on →</CTA>
    </div>
  </section>

  <!-- Studios (dark section) -->
  <section class="bg-ink text-paper">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <h2 class="font-display text-2xl md:text-3xl">Studios are operating systems</h2>
      <p class="mt-4 text-lg text-paper/65 max-w-3xl">
        Studios are not rooms. They're operating systems. A good studio reduces friction, increases output, improves quality, and turns content into a repeatable business function, content production, livestreaming, podcasts, photography, commercial production, live commerce, corporate events.
      </p>
      <div class="mt-10 grid md:grid-cols-2 gap-8">
        {studios.map((s) => (
          <a href="/studios" class="block rounded-lg overflow-hidden border border-paper/15 group">
            {s.data.thumbnail ? (
              <div class="aspect-video overflow-hidden bg-paper/5">
                <img src={s.data.thumbnail} alt={s.data.title} class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]" />
              </div>
            ) : (
              <div class="aspect-video bg-paper/5 flex items-center justify-center px-6 text-center">
                <p class="text-xs uppercase tracking-wide text-paper/35 italic">Need a {s.data.title} photo here.</p>
              </div>
            )}
            <div class="p-6">
              <h3 class="font-display text-lg">{s.data.title}</h3>
              <p class="mt-1 text-sm text-paper/60">{s.data.tagline}</p>
            </div>
          </a>
        ))}
      </div>
      <div class="mt-10">
        <a href="/studios" class="inline-flex items-center justify-center px-6 py-3 rounded-full text-sm font-medium border border-paper/30 text-paper hover:border-paper transition-colors">
          See the Studios →
        </a>
      </div>
    </div>
  </section>

  <!-- What I Do: Split -->
  <section class="max-w-6xl mx-auto px-6 py-20 border-t border-ink/10">
    <p class="eyebrow">What I do</p>
    <h2 class="font-display text-2xl md:text-3xl mt-3 mb-3" style="max-width: 22rem;">Depends on what you need.</h2>
    <p class="text-ink/60 max-w-2xl mb-14">Brands, agencies, studios, founders, production teams. Where you land in what I do depends on the problem you're solving.</p>
    <div class="split-grid">
      <div class="split-col">
        <p class="col-label">When you need a production lead</p>
        {servicesLeft.map((s) => (
          <div class="cap">
            <h3 class="font-display">{s.title}</h3>
            <p class="text-sm text-ink/60 mt-1 leading-relaxed">{s.body}</p>
          </div>
        ))}
      </div>
      <div class="split-col split-col-right">
        <p class="col-label">When you need an ops or strategy partner</p>
        {servicesRight.map((s) => (
          <div class="cap">
            <h3 class="font-display">{s.title}</h3>
            <p class="text-sm text-ink/60 mt-1 leading-relaxed">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
    <p class="mt-10 pt-6 border-t border-ink/10 text-sm text-ink/40 italic font-display">Most clients are looking for one side of this. Some need both.</p>
  </section>

  <!-- Featured Work -->
  <section class="max-w-6xl mx-auto px-6 py-20 border-t border-ink/10">
    <div class="flex items-baseline justify-between">
      <h2 class="font-display text-2xl md:text-3xl">Featured work</h2>
      <a href="/work" class="text-sm font-medium text-ink/55 hover:text-rust">See all work →</a>
    </div>
    <p class="mt-2 text-sm text-ink/40 italic">Under construction, my library's still getting its life together after 20 years.</p>
    <!-- Cinemascope hero -->
    <a href={`/work/${featured[0].id}`} class="group block mt-10">
      <div class="w-full overflow-hidden rounded-lg bg-ink/5" style="aspect-ratio: 21/9;">
        <img
          src={featured[0].data.thumbnail}
          alt={featured[0].data.title}
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
        />
      </div>
      <div class="mt-3 flex items-baseline justify-between gap-3">
        <h3 class="font-display text-xl text-ink">{featured[0].data.title}</h3>
        <span class="text-xs uppercase tracking-wide text-ink/40">{featured[0].data.category.replace('-', ' ')}</span>
      </div>
      {featured[0].data.client && <p class="text-sm text-ink/55">{featured[0].data.client}</p>}
    </a>
    <!-- Three below -->
    <div class="mt-8 grid md:grid-cols-3 gap-8">
      {featured.slice(1).map((item) => (
        <WorkCard
          slug={item.id}
          title={item.data.title}
          client={item.data.client}
          category={item.data.category}
          thumbnail={item.data.thumbnail}
        />
      ))}
    </div>
  </section>

  <!-- About Teaser -->
  <section class="max-w-6xl mx-auto px-6 py-20">
    <h2 class="font-display text-2xl md:text-3xl">{aboutTeaser.heading}</h2>
    <p class="mt-4 text-lg text-ink/65 max-w-3xl font-display italic">
      "{aboutTeaser.quote}"
    </p>
    <div class="mt-6">
      <CTA href={aboutTeaser.ctaHref} variant="secondary">{aboutTeaser.ctaLabel}</CTA>
    </div>
  </section>

  <!-- Recipe Teaser -->
  <section class="max-w-6xl mx-auto px-6 py-20 border-t border-ink/10">
    <div class="md:grid md:grid-cols-[1fr_280px] md:gap-16 md:items-center">
      <div>
        <p class="text-sm uppercase tracking-wide font-medium text-rust">Real food. Actual schedule.</p>
        <h2 class="mt-3 font-display text-2xl md:text-3xl">Death to Sad Protein Block for Dinner</h2>
        <p class="mt-4 text-lg text-ink/65 max-w-xl">
          Work runs 60 hours a week. There's family, training, and a dog who doesn't care about your calendar. By the time everything else is handled, eating well either gets planned or it gets skipped. 30 minutes on Sunday. 10-minute dinners the rest of the week.
        </p>
        <div class="mt-8">
          <a href="/recipes" class="inline-flex items-center justify-center px-6 py-3 rounded-full text-sm font-medium border border-ink/25 text-ink hover:border-ink transition-colors">
            See the recipes →
          </a>
        </div>
      </div>
      <div class="mt-10 md:mt-0">
        <div class="aspect-[4/3] rounded-lg overflow-hidden bg-ink/5">
          <img src="/images/recipes/pasta.jpg" alt="Real food, real schedule" class="h-full w-full object-cover" />
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-ink text-paper">
    <div class="max-w-6xl mx-auto px-6 py-24 text-center">
      <h2 class={`font-display md:${finalCta.headingSize} max-w-3xl mx-auto`}>{finalCta.heading}</h2>
      <div class="mt-10 flex justify-center">
        <a href={finalCta.buttonHref} class="inline-flex items-center justify-center px-8 py-4 rounded-full text-sm font-medium bg-paper text-ink hover:bg-rust hover:text-paper transition-colors">
          {finalCta.buttonLabel}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .eyebrow {
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgba(28, 25, 23, 0.42);
  }

  .split-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    position: relative;
  }

  .split-grid::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    background: rgba(28, 25, 23, 0.20);
    transform: translateX(-50%);
    pointer-events: none;
  }

  .split-col-right {
    padding-left: 3.5rem;
  }

  .col-label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #9b4a2a;
    font-weight: 600;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(28, 25, 23, 0.10);
  }

  .cap {
    padding: 1.35rem 0;
    border-bottom: 1px solid rgba(28, 25, 23, 0.10);
  }

  .cap:last-of-type {
    border-bottom: none;
  }

  .motion-badge {
    display: inline-flex;
    align-items: center;
    font-size: 9.5px;
    text-transform: uppercase;
    letter-spacing: 0.10em;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 999px;
    border: 1px solid rgba(155, 74, 42, 0.28);
    color: #9b4a2a;
    white-space: nowrap;
  }

  .motion-type {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: rgba(28, 25, 23, 0.42);
  }

  .motion-thumb {
    aspect-ratio: 16/10;
    margin-top: 0.15rem;
  }

  @media (max-width: 640px) {
    .split-grid {
      grid-template-columns: 1fr;
    }
    .split-grid::before {
      display: none;
    }
    .split-col-right {
      padding-left: 0;
      padding-top: 2.5rem;
      margin-top: 2.5rem;
      border-top: 1px solid rgba(28, 25, 23, 0.10);
    }
  }
</style>
