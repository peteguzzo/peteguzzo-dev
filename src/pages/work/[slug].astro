---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCard from '../../components/WorkCard.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const work = await getCollection('work');
  return work.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const data = item.data;

const allWork = await getCollection('work');
const related = allWork
  .filter((w) => w.id !== item.id && w.data.category === data.category)
  .slice(0, 3);
---

<BaseLayout title={data.title} description={data.shortDescription} image={data.thumbnail}>
  <article class="max-w-3xl mx-auto px-6 py-16">
    <a href="/work" class="text-sm text-ink/55 hover:text-ink">← Back to Work</a>
    <div class="mt-6 flex items-center gap-3">
      <span class="text-xs uppercase tracking-wide px-3 py-1 rounded-full border border-ink/15 text-ink/55">
        {data.category.replace('-', ' ')}
      </span>
    </div>
    <h1 class="mt-4 font-display text-3xl md:text-5xl">{data.title}</h1>
    {data.client && <p class="mt-3 text-ink/55">{data.client}</p>}

    {data.vimeoUrl ? (
      <div class="mt-8 aspect-video rounded-xl overflow-hidden bg-ink/5">
        <iframe
          src={data.vimeoUrl}
          class="w-full h-full"
          frameborder="0"
          allow="autoplay; fullscreen; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
    ) : (
      <div class="mt-8 aspect-video rounded-xl overflow-hidden bg-ink/5">
        <img src={data.thumbnail} alt={data.title} class="w-full h-full object-cover" />
      </div>
    )}

    <div class="mt-10 prose max-w-none">
      <Content />
    </div>
  </article>

  {related.length > 0 && (
    <section class="max-w-6xl mx-auto px-6 py-16 border-t border-ink/10">
      <h2 class="font-display text-xl">More {data.category.replace('-', ' ')} work</h2>
      <div class="mt-8 grid md:grid-cols-3 gap-8">
        {related.map((r) => (
          <WorkCard
            slug={r.id}
            title={r.data.title}
            client={r.data.client}
            category={r.data.category}
            thumbnail={r.data.thumbnail}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
