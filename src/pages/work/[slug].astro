---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCard from '../../components/WorkCard.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const work = await getCollection('work');
  return work.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const data = item.data;

const allWork = (await getCollection('work')).filter((w) => !w.data.hidden);
const related = data.relatedWork
  ? allWork.filter((w) => data.relatedWork!.includes(w.id))
  : allWork.filter((w) => w.id !== item.id && w.data.category === data.category).slice(0, 3);
---

<BaseLayout title={data.title} description={data.shortDescription} image={data.thumbnail}>
  <article class="max-w-3xl mx-auto px-6 py-16">
    <a href="/work" class="text-sm text-ink/55 hover:text-ink">← Back to Work</a>
    <div class="mt-6 flex items-center gap-3">
      <span class="text-xs uppercase tracking-wide px-3 py-1 rounded-full border border-ink/15 text-ink/55">
        {data.category.replace('-', ' ')}
      </span>
    </div>
    <h1 class="mt-4 font-display text-3xl md:text-5xl">{data.title}</h1>
    {data.client && <p class="mt-3 text-ink/55">{data.client}</p>}

    {data.vimeoUrl ? (
      <div
        class="mt-8 aspect-video rounded-xl overflow-hidden bg-ink/5 relative group cursor-pointer"
        id="video-facade"
        data-vimeo-url={data.vimeoUrl}
      >
        <img src={data.thumbnail} alt={data.title} class="w-full h-full object-cover" />
        <div class="absolute inset-0 flex items-center justify-center bg-black/20 group-hover:bg-black/35 transition-colors">
          <span class="flex items-center justify-center w-20 h-20 rounded-full bg-paper/90 text-ink group-hover:bg-rust group-hover:text-paper transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          </span>
        </div>
      </div>
    ) : data.videoComingSoon ? (
      <div class="mt-8 aspect-video rounded-xl overflow-hidden bg-ink/5 flex flex-col items-center justify-center gap-3 border border-ink/10">
        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-ink/25"><polygon points="5 3 19 12 5 21 5 3"/></svg>
        <p class="text-sm text-ink/40 uppercase tracking-widest">Video — Coming Soon</p>
      </div>
    ) : (
      <div class="mt-8 aspect-video rounded-xl overflow-hidden bg-ink/5">
        <img src={data.thumbnail} alt={data.title} class="w-full h-full object-cover" />
      </div>
    )}

    <div class="mt-10 prose max-w-none">
      <Content />
    </div>

    {data.gallery.length > 0 && (
      <div class="mt-12 grid grid-cols-2 gap-4">
        {data.gallery.map((img) => (
          <div class="rounded-lg overflow-hidden bg-ink/5">
            <img src={img} alt="" class="w-full h-full object-cover" loading="lazy" />
          </div>
        ))}
      </div>
    )}
  </article>

  {related.length > 0 && (
    <section class="max-w-6xl mx-auto px-6 py-16 border-t border-ink/10">
      <h2 class="font-display text-xl">More {data.category.replace('-', ' ')} work</h2>
      <div class="mt-8 grid md:grid-cols-3 gap-8">
        {related.map((r) => (
          <WorkCard
            slug={r.id}
            title={r.data.title}
            client={r.data.client}
            category={r.data.category}
            thumbnail={r.data.thumbnail}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<script>
  const facade = document.getElementById('video-facade');
  if (facade) {
    facade.addEventListener('click', () => {
      const url = (facade as HTMLElement).dataset.vimeoUrl + '&autoplay=1';
      const iframe = document.createElement('iframe');
      iframe.src = url;
      iframe.className = 'w-full h-full';
      iframe.setAttribute('frameborder', '0');
      iframe.setAttribute('allow', 'autoplay; fullscreen; picture-in-picture');
      iframe.setAttribute('allowfullscreen', '');
      facade.innerHTML = '';
      facade.classList.remove('cursor-pointer', 'group');
      facade.appendChild(iframe);
    });
  }
</script>
