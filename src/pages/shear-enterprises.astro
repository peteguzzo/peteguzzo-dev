---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CTA from '../components/CTA.astro';
---

<BaseLayout
  title="EVP, Shear Enterprises"
  description="Executive Vice President of Shear Enterprises LLC — overseeing marketing strategy, operations, content systems, and growth across Rhonda Shear Intimates, Shear Media Studios, Up All Night Network, and affiliated ventures."
>
  <Hero
    eyebrow="Shear Enterprises LLC"
    title="Executive Vice President"
    subtitle="Operating at the intersection of marketing strategy, commercial operations, executive leadership, and modern content systems — partnering closely with ownership and senior leadership to drive scalable growth, organizational clarity, and execution across the enterprise."
  />

  <!-- Brands section -->
  <section class="max-w-6xl mx-auto px-6 pb-16">
    <p class="font-display text-xl text-rust">Overseeing three operating businesses and a growing portfolio of joint ventures.</p>

    <div class="mt-10 grid md:grid-cols-3 gap-8">
      <!-- Rhonda Shear Intimates -->
      <a href="https://rhondashear.com" target="_blank" rel="noopener" class="group rounded-lg border border-ink/10 overflow-hidden flex flex-col hover:border-rust/40 transition-colors">
        <div class="relative aspect-video overflow-hidden bg-ink/5">
          <img src="/images/evp/RSI Photo to UseIMG_5009.JPG" alt="Rhonda Shear Intimates" class="h-full w-full object-cover object-top transition-transform duration-300 group-hover:scale-[1.03]" />
          <div class="absolute inset-0 bg-gradient-to-t from-paper/90 via-paper/20 to-transparent flex items-end px-5 pb-4">
            <img src="/images/evp/logo_asset-1780203732016.webp" alt="Rhonda Shear Intimates" class="h-10 object-contain" />
          </div>
        </div>
        <div class="p-5">
          <p class="text-sm text-ink/55">Brand, e-commerce, TV retail, live shopping, and multi-channel distribution strategy</p>
        </div>
      </a>

      <!-- Shear Media Studios -->
      <a href="https://shearmediastudios.com" target="_blank" rel="noopener" class="group rounded-lg border border-ink/10 overflow-hidden flex flex-col hover:border-rust/40 transition-colors">
        <div class="aspect-video bg-ink/5 flex items-center justify-center p-10 overflow-hidden">
          <img src="/images/evp/Black logo - no background.png" alt="Shear Media Studios" class="max-h-full max-w-full object-contain transition-transform duration-300 group-hover:scale-[1.03]" />
        </div>
        <div class="p-5">
          <p class="text-sm text-ink/55">Studio strategy, content production, live events, and creative execution</p>
        </div>
      </a>

      <!-- Up All Night Network -->
      <div class="group rounded-lg border border-ink/10 overflow-hidden flex flex-col">
        <div class="aspect-video overflow-hidden bg-ink">
          <img src="/images/evp/Up All Night roku logo mock up.jpg" alt="The Up All Night Network — Available Now on Roku" class="h-full w-full object-cover object-top transition-transform duration-300 group-hover:scale-[1.03]" />
        </div>
        <div class="p-5">
          <p class="text-sm text-ink/55">Streaming content strategy and distribution — now live on Roku</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Role overview -->
  <section class="max-w-6xl mx-auto px-6 py-16 border-t border-ink/10">
    <div class="grid md:grid-cols-[1fr_2fr] gap-12">
      <div>
        <h2 class="font-display text-2xl md:text-3xl">The role</h2>
        <p class="mt-3 text-sm text-ink/55">Shear Enterprises LLC</p>
      </div>
      <div class="space-y-5 text-ink/75 leading-relaxed">
        <p>Executive Vice President responsible for marketing strategy, growth, organizational alignment, and AI-assisted operational workflows across Shear Enterprises — including Shear Media Studios, Rhonda Shear Intimates, and affiliated business units.</p>
        <p>This isn't one lane. It's brand architecture, go-to-market strategy, content systems, commerce operations, team structure, and executive leadership — running in parallel across three businesses that need to work as one enterprise.</p>
        <p>Partnering directly with ownership and senior leadership. Driving clarity, execution, and scale across the portfolio.</p>
      </div>
    </div>
  </section>

  <!-- What I'm actually doing -->
  <section class="max-w-6xl mx-auto px-6 py-16 border-t border-ink/10">
    <h2 class="font-display text-2xl md:text-3xl">Executive scope</h2>
    <p class="mt-4 text-lg text-ink/65 max-w-3xl">The work that doesn't fit in a single job title.</p>

    <div class="mt-10 divide-y divide-ink/10">
      <div class="grid md:grid-cols-[5rem_1fr_2fr] gap-4 py-6 items-baseline">
        <span class="font-display text-rust/70 text-sm">01</span>
        <h3 class="font-display text-lg">Enterprise Marketing Strategy</h3>
        <p class="text-sm text-ink/60 max-w-md">Aligning brand, content, commerce, and AI-enhanced workflows to core business objectives. Not separate marketing plans — one enterprise strategy that runs across all three businesses.</p>
      </div>
      <div class="grid md:grid-cols-[5rem_1fr_2fr] gap-4 py-6 items-baseline">
        <span class="font-display text-rust/70 text-sm">02</span>
        <h3 class="font-display text-lg">E-Commerce Strategy</h3>
        <p class="text-sm text-ink/60 max-w-md">Direct-to-consumer strategy for Rhonda Shear Intimates — product positioning, digital merchandising, conversion optimization, and channel strategy built around the brand's core customer and how she shops.</p>
      </div>
      <div class="grid md:grid-cols-[5rem_1fr_2fr] gap-4 py-6 items-baseline">
        <span class="font-display text-rust/70 text-sm">03</span>
        <h3 class="font-display text-lg">Live Shopping Strategy</h3>
        <p class="text-sm text-ink/60 max-w-md">Building and running live commerce operations across TV retail, streaming, and digital platforms. Real-time selling at the speed live retail actually runs — scripted for conversion, not just for content.</p>
      </div>
      <div class="grid md:grid-cols-[5rem_1fr_2fr] gap-4 py-6 items-baseline">
        <span class="font-display text-rust/70 text-sm">04</span>
        <h3 class="font-display text-lg">Amazon</h3>
        <p class="text-sm text-ink/60 max-w-md">Channel strategy, product listing optimization, and brand presence on Amazon — integrating it into the broader multi-channel distribution model rather than treating it as a standalone afterthought.</p>
      </div>
      <div class="grid md:grid-cols-[5rem_1fr_2fr] gap-4 py-6 items-baseline">
        <span class="font-display text-rust/70 text-sm">05</span>
        <h3 class="font-display text-lg">Brand Architecture + Positioning</h3>
        <p class="text-sm text-ink/60 max-w-md">Shaping how Rhonda Shear Intimates and related businesses are positioned across every channel — from TV retail to e-commerce to streaming — so the brand reads consistently no matter where someone encounters it.</p>
      </div>
      <div class="grid md:grid-cols-[5rem_1fr_2fr] gap-4 py-6 items-baseline">
        <span class="font-display text-rust/70 text-sm">06</span>
        <h3 class="font-display text-lg">Studio + Content Operations</h3>
        <p class="text-sm text-ink/60 max-w-md">Executive oversight of Shear Media Studios — ensuring content, media, live events, and creative execution function as intentional growth levers for the broader enterprise, not just a production facility that happens to exist.</p>
      </div>
      <div class="grid md:grid-cols-[5rem_1fr_2fr] gap-4 py-6 items-baseline">
        <span class="font-display text-rust/70 text-sm">07</span>
        <h3 class="font-display text-lg">AI-Assisted Operations</h3>
        <p class="text-sm text-ink/60 max-w-md">Integrating AI tools and automation systems into content, marketing, and operational workflows — improving scalability, efficiency, and creative execution without replacing the judgment that makes the work land.</p>
      </div>
      <div class="grid md:grid-cols-[5rem_1fr_2fr] gap-4 py-6 items-baseline">
        <span class="font-display text-rust/70 text-sm">08</span>
        <h3 class="font-display text-lg">Organizational Development</h3>
        <p class="text-sm text-ink/60 max-w-md">Team structures, accountability systems, and culture evolution that support scale and execution — not org charts for the sake of them, but clarity about who owns what and how decisions get made.</p>
      </div>
    </div>
  </section>

  <!-- Multi-channel distribution -->
  <section class="bg-ink text-paper">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <h2 class="font-display text-2xl md:text-3xl">Multi-channel distribution</h2>
      <p class="mt-4 text-lg text-paper/65 max-w-3xl">
        Rhonda Shear Intimates doesn't live in one place. TV retail, e-commerce, live shopping, streaming, Amazon — each channel has its own operating logic, its own customer behavior, its own content requirements. The job is making sure they work together instead of competing with each other.
      </p>
      <div class="mt-10 grid md:grid-cols-2 gap-8">
        <div class="rounded-lg border border-paper/15 p-6">
          <h3 class="font-display text-lg">TV Retail</h3>
          <p class="mt-2 text-sm text-paper/65">Live commerce television. High-volume, real-time selling with direct conversion. Product positioning, scripting, and on-screen performance built around the metrics that actually matter — units per minute, sell-through, and reorder rate.</p>
        </div>
        <div class="rounded-lg border border-paper/15 p-6">
          <h3 class="font-display text-lg">E-Commerce (DTC)</h3>
          <p class="mt-2 text-sm text-paper/65">Direct-to-consumer digital — website, email, and paid channels. Strategy built around customer lifetime value, not just acquisition cost. Making the digital experience work as hard as the TV channel does.</p>
        </div>
        <div class="rounded-lg border border-paper/15 p-6">
          <h3 class="font-display text-lg">Live Shopping</h3>
          <p class="mt-2 text-sm text-paper/65">Streaming-native live commerce across digital platforms. Real-time selling that meets the customer where she's already watching — not just repurposing TV content for a different screen.</p>
        </div>
        <div class="rounded-lg border border-paper/15 p-6">
          <h3 class="font-display text-lg">Amazon</h3>
          <p class="mt-2 text-sm text-paper/65">Brand presence, product listings, and channel strategy on Amazon — integrated into the broader distribution model rather than managed as a separate business unit.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="max-w-6xl mx-auto px-6 py-24 text-center">
    <h2 class="font-display text-2xl md:text-3xl max-w-2xl mx-auto">Questions about the work at Shear Enterprises?</h2>
    <div class="mt-8">
      <CTA href="/contact">Get in touch →</CTA>
    </div>
  </section>
</BaseLayout>
