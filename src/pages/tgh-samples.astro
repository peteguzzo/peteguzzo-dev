---
import BaseLayout from '../layouts/BaseLayout.astro';

const sections = [
  {
    client: "CSL Plasma",
    items: [
      { title: "Alice", role: "Director & Creative Producer", vimeoUrl: "https://player.vimeo.com/video/938377703", vimeoId: "938377703" },
      { title: "Benjamin", role: "Director & Creative Producer", vimeoUrl: "https://player.vimeo.com/video/899853303", vimeoId: "899853303" },
      { title: "Dreamers", role: "Producer", vimeoUrl: "https://player.vimeo.com/video/735426960", vimeoId: "735426960" },
      { title: "What is Plasma", role: "Producer", vimeoUrl: "https://player.vimeo.com/video/969855002", vimeoId: "969855002" },
    ],
  },
  {
    client: "Jackson Health System",
    items: [
      { title: "Michelle", role: "Director & Creative Producer", vimeoUrl: "https://player.vimeo.com/video/433373194", vimeoId: "433373194" },
      { title: "Miracles Made Daily", role: "Director & Producer", vimeoUrl: "https://player.vimeo.com/video/247861743", vimeoId: "247861743" },
    ],
  },
  {
    client: "Medi-Weightloss",
    items: [
      { title: "Norma", role: "Director & Creative Producer", vimeoUrl: "https://player.vimeo.com/video/927667969", vimeoId: "927667969" },
      { title: "Laura", role: "Director & Creative Producer", vimeoUrl: "https://player.vimeo.com/video/927691288", vimeoId: "927691288" },
      { title: "Familia", role: "Director & Producer", vimeoUrl: "https://player.vimeo.com/video/409578005", vimeoId: "409578005" },
    ],
  },
];
---

<BaseLayout title="Medical & Health Production — Pete Guzzo" description="Pete Guzzo's medical and healthcare production work — CSL Plasma, Jackson Health, Medi-Weightloss.">
  <div class="max-w-6xl mx-auto px-6 py-16">

    <div class="mb-14">
      <p class="text-xs uppercase tracking-widest text-rust font-semibold mb-2">Pete Guzzo</p>
      <h1 class="font-display text-3xl md:text-4xl">Medical & Health Production</h1>
    </div>

    {sections.map((section) => (
      <div class="mb-16">
        <h2 class="font-display text-xl mb-8 border-b border-ink/10 pb-4">{section.client}</h2>
        <div class="grid md:grid-cols-2 gap-8">
          {section.items.map((item) => (
            <div>
              <div class="aspect-video bg-ink/5 overflow-hidden rounded-sm mb-3">
                <iframe
                  src={item.vimeoUrl}
                  class="w-full h-full"
                  allow="autoplay; fullscreen; picture-in-picture"
                  allowfullscreen
                  loading="lazy"
                  title={item.title}
                />
              </div>
              <div class="flex items-baseline justify-between gap-4">
                <div>
                  <p class="font-medium text-sm">{item.title}</p>
                  <p class="text-xs text-ink/50 mt-0.5">{item.role}</p>
                </div>
                <a
                  href={`https://vimeo.com/${item.vimeoId}`}
                  target="_blank"
                  rel="noopener"
                  class="text-xs text-rust shrink-0 hover:underline"
                >
                  Vimeo →
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}

    <div class="border-t border-ink/10 pt-10 text-sm text-ink/50">
      Pete Guzzo · EVP, Shear Enterprises LLC ·
      <a href="mailto:pg2@peteguzzo.com" class="text-rust hover:underline">pg2@peteguzzo.com</a>
    </div>

  </div>
</BaseLayout>
